<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Si es un archivo real, permitir el acceso
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Si es un directorio real, permitir el acceso
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirigir todo a index.php
    RewriteRule ^ index.php [L]
</IfModule>
